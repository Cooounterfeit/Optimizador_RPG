    "damageCalculator": {
      "note": "Additional crit damage is a percentage: 50 means +50%.",
      "title": "Damage per hit",
      "fields": [
        {
          "id": "attack",
          "min": 0,
          "label": "Attack",
          "default": 0
        },
        {
          "id": "baseDamage",
          "min": 0,
          "label": "Base damage",
          "default": 0
        },
        {
          "id": "critDamage",
          "min": 0,
          "unit": "percent",
          "label": "Additional crit damage",
          "default": 0
        },
        {
          "id": "critChance",
          "max": 100,
          "min": 0,
          "unit": "percent",
          "label": "Crit chance",
          "default": 0
        },
        {
          "id": "defense",
          "min": 0,
          "label": "Enemy defense",
          "default": 0
        }
      ],
      "outputs": [
        {
          "id": "withoutCrit",
          "label": "Damage without crit",
          "formula": "max(0, attack + baseDamage - defense)"
        },
        {
          "id": "withCrit",
          "label": "Damage with crit",
          "formula": "max(0, (attack + baseDamage) * (1 + critDamage / 100) - defense)"
        },
        {
          "id": "average",
          "label": "Average damage per hit",
          "formula": "withoutCrit * (1 - critChance / 100) + withCrit * (critChance / 100)",
          "decimals": 1
        }
      ],
      "description": "Estimate one hit with and without a critical, using this game's own formula."
    },
